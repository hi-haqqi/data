{
  "manifest_version": 3,
  "name": "Auto Comment Assistant",
  "version": "1.0.0",
  "description": "Isi komentar sekali klik dari template atau saran AI di Dribbble, LinkedIn, X/Twitter, Instagram, dan situs lain.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "fill-random": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Isi kotak komentar aktif dengan template acak"
    },
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Buka panel + saran AI untuk kotak komentar aktif"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dribbble.com/*",
        "https://*.behance.net/*",
        "https://*.linkedin.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*",
        "https://*.youtube.com/*",
        "https://*.reddit.com/*"
      ],
      "js": ["lib.js", "platforms.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
